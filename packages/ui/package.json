{
  "name": "@app/ui",
  "version": "0.1.0",
  "private": true,
  "sideEffects": [
    "*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tamagui.config": "./src/tamagui.config.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
