  },
  "dependencies": {
    "@app/types": "workspace:*",
    "@tamagui/config": "^1.116.0",
    "@tamagui/core": "^1.116.0",
    "@tamagui/lucide-icons": "^1.116.0",
    "tamagui": "^1.116.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  }
}
