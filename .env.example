# Environment Configuration
# Copy this file to .env and update with your values
# Never commit .env files to version control!

# ===========================================
# ENVIRONMENT
# ===========================================

# Application environment (development | staging | production)
APP_ENV=development

# ===========================================
# API CONFIGURATION
# ===========================================

# API Base URL (overrides environment default)
API_BASE_URL=https://api.example.com

# ===========================================
# AUTHENTICATION
# ===========================================

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id.apps.googleusercontent.com

# Microsoft Entra ID (Azure AD)
ENTRA_CLIENT_ID=your-entra-client-id
ENTRA_TENANT_ID=common

# Auth Redirect URIs
AUTH_REDIRECT_URI=http://localhost:5173/auth/callback
AUTH_POST_LOGOUT_URI=http://localhost:5173

# ===========================================
# ANALYTICS & MONITORING
# ===========================================

# Sentry Error Reporting
SENTRY_DSN=

# Analytics
ANALYTICS_KEY=

# ===========================================
# EXPO (Mobile Only)
# ===========================================

# Expo project configuration
EXPO_PUBLIC_API_URL=http://localhost:3000/api
