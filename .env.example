# Authentication Configuration
# Copy this file to .env and fill in your values

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id.apps.googleusercontent.com

# Microsoft Entra ID (Azure AD)
ENTRA_CLIENT_ID=your-entra-client-id
ENTRA_TENANT_ID=common  # Use 'common' for multi-tenant, or your specific tenant ID

# Auth Redirect URIs
AUTH_REDIRECT_URI=http://localhost:5173/auth/callback
AUTH_POST_LOGOUT_URI=http://localhost:5173

# API Configuration
API_BASE_URL=https://api.example.com
